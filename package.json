{
  "name": "mem-link",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bench": "node scripts/bench-eval.mjs",
    "verify": "node scripts/cdp-verify.mjs",
    "verify:follow": "node scripts/cdp-verify-follow.mjs",
    "verify:core": "node scripts/cdp-verify-core.mjs",
    "verify:tree": "node scripts/cdp-verify-tree.mjs",
    "verify:tree:trunc": "node scripts/cdp-verify-tree-truncation.mjs",
    "verify:add-defaults": "node scripts/cdp-verify-add-defaults.mjs",
    "verify:default-nodes": "node scripts/cdp-verify-default-nodes.mjs",
    "packs:references": "node store/scripts/build-references.mjs --root store",
    "packs:index": "node store/scripts/build-references.mjs --root store && node store/scripts/build-index.mjs store",
    "packs:check": "node store/scripts/build-references.mjs --root store --check && node store/scripts/build-index.mjs store --check",
    "packs:port:nybble": "node store/scripts/port-nybble.mjs --root store --write",
    "packs:port:imhex": "node store/scripts/port-imhex.mjs --root store --src .cache/imhex-patterns/patterns --write",
    "packs:publish": "node scripts/publish-pack-store.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sucrase": "3.35.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.5"
  }
}
